FLARESOLVERR_URL=http://your-flaresolverr-host:8191/v1
NOTIFY_WEBHOOK_URL=https://your-notify-webhook-url
# Optional. Reuse a warm FlareSolverr browser session (faster; see
# common/fetch.py). The run scripts set the name per platform; set this to 0
# here to force sessionless everywhere without editing them. Default: on.
FLARESOLVERR_SESSIONS=1
