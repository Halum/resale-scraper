  "nodes": [
    {
      "id": "b1000000-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-460, 100],
      "parameters": {
        "httpMethod": "POST",
        "path": "scraper-alert",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "e13b736b-7c09-4eab-81c0-3b4ed6be6295"
