        }
      },
      "webhookId": "9f3f4260-f33f-4f12-a5d3-d22199be08d9"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Set Config", "type": "main", "index": 0 }]]
    },
    "Set Config": {
      "main": [[{ "node": "Telegram Alert", "type": "main", "index": 0 }]]
