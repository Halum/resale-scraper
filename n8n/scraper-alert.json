              "id": "c0000000-0000-0000-0000-000000000001",
              "name": "TELEGRAM_CHAT_ID",
              "value": "REPLACE_WITH_TELEGRAM_CHAT_ID",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "b1000000-0000-4000-8000-000000000002",
      "name": "Telegram Alert",
